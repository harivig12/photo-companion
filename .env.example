# Copy to .env (never commit .env).

# Immich server as seen from inside the container. "localhost" would mean the container itself.
IMMICH_URL=http://192.168.1.10:2283

# Immich > Account Settings > API Keys. Grant the permissions listed in docs/plan.md section 2.
IMMICH_API_KEY=replace-me

# First UI password (12+ characters). Leave empty to have one generated and printed once in the log.
PHOTOS_PASSWORD=

# 127.0.0.1 = this machine only. 0.0.0.0 = reachable from the LAN (traffic is plain HTTP).
PHOTOS_BIND=127.0.0.1

# Set true only when a reverse proxy serves the UI over HTTPS.
PHOTOS_SECURE_COOKIE=false

PHOTOS_SESSION_HOURS=12

# immich = upload results and add them to album / tag / stack / Memories.
# folder = test mode: save results to PHOTOS_OUTPUT_DIR (default <data>/output), never write to Immich.
PHOTOS_OUTPUT_MODE=immich

# ffmpeg executable. The Docker image has it on PATH; on Windows give the full path to ffmpeg.exe.
PHOTOS_FFMPEG=ffmpeg
